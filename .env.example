# W-AI Environment Variables
# Copy this file to .env.local for local development

# MiMo API (required)
MIMO_API=your_mimo_api_key_here

# 기상청 공공데이터 API (required for real weather data)
POTAL_API=your_public_data_api_key_here

# 공공데이터포털 지원금 API (optional, has fallback)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here

# 네이버 검색 API (optional, has fallback)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 네이버 지도 (Vite client-side, set in Vercel dashboard)
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id
